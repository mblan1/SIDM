{
  "manifest_version": 3,
  "name": "SIDM (Snw Internet Download Manager)",
  "short_name": "SIDM",
  "version": "0.1.0",
  "description": "Capture downloads and hand them to the SIDM desktop app for fast multi-segment downloading.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "nativeMessaging",
    "notifications",
    "storage",
    "webRequest",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "SIDM",
    "default_popup": "popup.html"
  }
}
