<ui:FluentWindow x:Class="SIDM.App.Views.CategoryEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Category"
                 Height="400"
                 Width="540"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <Grid Margin="24,48,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Top" Title="Category" />

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Name" Margin="0,0,0,4" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="e.g. Video, Audio, Software" />

            <TextBlock Text="Extensions" Margin="0,16,0,4" />
            <ui:TextBox x:Name="ExtensionsBox" PlaceholderText="mp4, mkv, webm" />
            <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.65"
                       Text="Comma- or semicolon-separated. The leading dot is optional and case is ignored." />

            <TextBlock Text="Default save folder" Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" x:Name="PathBox" PlaceholderText="D:\Videos" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="OnBrowse" />
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" Margin="0,12,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
            <ui:Button Content="Save" Appearance="Primary" Click="OnAccept" IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
