<ui:FluentWindow x:Class="SIDM.App.Views.RemoveConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Remove downloads"
                 Height="240"
                 Width="480"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Resources/sidm.png"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Remove downloads" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                <TextBlock x:Name="HeadlineText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                           Text="The download entries will be removed from SIDM. Choose whether to delete the downloaded file(s) from disk as well." />
                <CheckBox x:Name="DeleteFilesCheckBox"
                          Margin="0,16,0,0"
                          Content="Also delete the downloaded file(s) from disk" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.65"
                           Text="This cannot be undone." />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                <ui:Button Content="Remove" Appearance="Primary" Click="OnConfirm" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
