<ui:FluentWindow x:Class="SIDM.App.Views.DownloadProgressDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SIDM.App.ViewModels"
                 mc:Ignorable="d"
                 Title="Download progress"
                 Height="640"
                 Width="780"
                 MinHeight="480"
                 MinWidth="620"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Resources/sidm.png"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="True"
                 d:DataContext="{d:DesignInstance Type=vm:DownloadRowViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Download progress" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- File summary -->
            <Border Grid.Row="0" Background="#15FFFFFF" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="36"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TargetPath}" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Url}" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Overall progress -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ProgressDisplay}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" FontWeight="SemiBold" />
                </Grid>
                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Maximum="100" Height="8" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Stats: Speed | Downloaded | Remaining | Time left -->
            <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                            ToolTip="{Binding SpeedModeToggleLabel}"
                            MouseLeftButtonUp="OnToggleSpeedMode">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SpeedModeLabel}" Opacity="0.6" FontSize="11" />
                                <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="10"
                                               Opacity="0.5" Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TransferRateDisplay}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Downloaded" Opacity="0.6" FontSize="11" />
                        <TextBlock Text="{Binding DownloadedBytesDisplay}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Remaining" Opacity="0.6" FontSize="11" />
                        <TextBlock Text="{Binding RemainingBytesDisplay}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Time left" Opacity="0.6" FontSize="11" />
                        <TextBlock Text="{Binding TimeLeftDisplay}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chunks header with live summary -->
            <Grid Grid.Row="3" Margin="0,16,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontWeight="SemiBold">
                    <Run Text="Chunks" />
                    <Run Text="  ·  " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding SegmentCount, Mode=OneWay}" />
                    <Run Text=" total" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding SegmentSummary}"
                           FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
            </Grid>

            <!-- Per-chunk grid with color-coded bars -->
            <Border Grid.Row="4" Background="#15FFFFFF" CornerRadius="8" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SegmentRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3,4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RangeDisplay}"
                                               FontSize="11" Opacity="0.85" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{Binding StatusBrush}"
                                            CornerRadius="3" Padding="6,1" HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <ProgressBar Grid.Column="2" Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                                 Height="6" Margin="8,0,8,0" VerticalAlignment="Center"
                                                 Foreground="{Binding StatusBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ProgressDisplay}"
                                               FontSize="11" Opacity="0.85" VerticalAlignment="Center"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Content="Cancel download"
                           Icon="{ui:SymbolIcon Symbol=Delete24}"
                           Click="OnCancelDownload"
                           ToolTip="Stop this download and delete the partial file from disk." />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="Pause" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Pause24}" Click="OnPause" />
                    <ui:Button Content="Resume" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Play24}" Click="OnResume" />
                    <ui:Button Content="Close" Appearance="Primary" Click="OnClose" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
