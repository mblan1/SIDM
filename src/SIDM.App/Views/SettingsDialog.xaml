<ui:FluentWindow x:Class="SIDM.App.Views.SettingsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SIDM.App.ViewModels"
                 mc:Ignorable="d"
                 Title="Settings"
                 Height="780"
                 Width="680"
                 MinHeight="420"
                 MinWidth="520"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Resources/sidm.png"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <ui:FluentWindow.Resources>
        <!-- Shared cell style for the Settings DataGrids (Schedule rules,
             Categories). Without an explicit selection trigger the default
             selection highlight is washed out against the Mica/transparent
             backdrop, so a selected or focused row gave no visual feedback.
             This paints the selected row with the accent fill like the main
             downloads grid. -->
        <Style x:Key="SettingsGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Appearance" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="Follow Windows or pin Light / Dark." />
                <ComboBox Width="200" HorizontalAlignment="Left" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem>Follow Windows</ComboBoxItem>
                    <ComboBoxItem>Light</ComboBoxItem>
                    <ComboBoxItem>Dark</ComboBoxItem>
                </ComboBox>

                <TextBlock Margin="0,24,0,0" Text="When the window close button is clicked" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="Hide to tray keeps SIDM running in the notification area. Exit shuts the app down." />
                <ComboBox Width="220" HorizontalAlignment="Left" SelectedIndex="{Binding CloseBehaviorIndex, Mode=TwoWay}">
                    <ComboBoxItem>Hide to tray</ComboBoxItem>
                    <ComboBoxItem>Exit completely</ComboBoxItem>
                </ComboBox>

                <TextBlock Margin="0,24,0,0" Text="Maximum concurrent downloads" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="More downloads finish in parallel; the rest wait in the queue." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding MaxConcurrent, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="{Binding MaxConcurrent}" FontWeight="SemiBold" />
                </Grid>

                <TextBlock Margin="0,20,0,0" Text="Global download speed limit" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="0 = unlimited. The cap is shared across all in-flight downloads and segments." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding BandwidthKiBPerSec, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PlaceholderText="0" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="KiB/s" Opacity="0.7" />
                </Grid>
                <TextBlock Margin="0,6,0,0" FontSize="11" Opacity="0.7"
                           Text="{Binding BandwidthDisplay}" />

                <TextBlock Margin="0,24,0,0" Text="Schedule rules" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="Allow downloads only during these windows. With no rules, downloads run any time." />

                <Border Background="#15FFFFFF" CornerRadius="6" Padding="4" Margin="0,4,0,0">
                    <DataGrid ItemsSource="{Binding Rules}"
                              SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CellStyle="{StaticResource SettingsGridCellStyle}"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#11FFFFFF"
                              BorderThickness="0"
                              Height="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Window" Binding="{Binding Window}" Width="120" />
                            <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="120" />
                            <DataGridTextColumn Header="Overrides" Binding="{Binding Caps}" Width="140" />
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Add24}" Content="Add" Click="OnAddRule" />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Edit24}" Margin="8,0,0,0" Content="Edit" Click="OnEditRule" />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Margin="8,0,0,0" Content="Remove" Click="OnDeleteRule" />
                </StackPanel>

                <TextBlock Margin="0,24,0,0" Text="Categories" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="Route downloads by file extension to a default save folder. Per-download folder memory still overrides the category default." />

                <Border Background="#15FFFFFF" CornerRadius="6" Padding="4">
                    <DataGrid ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CellStyle="{StaticResource SettingsGridCellStyle}"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#11FFFFFF"
                              BorderThickness="0"
                              Height="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Extensions" Binding="{Binding Extensions}" Width="180" />
                            <DataGridTextColumn Header="Default folder" Binding="{Binding DefaultPath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Add24}" Content="Add" Click="OnAddCategory" />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Edit24}" Margin="8,0,0,0" Content="Edit" Click="OnEditCategory" />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Margin="8,0,0,0" Content="Remove" Click="OnDeleteCategory" />
                </StackPanel>

                <TextBlock Margin="0,24,0,0" Text="Video downloader" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="YouTube and similar URLs are downloaded with yt-dlp; ffmpeg merges audio + video for high-quality formats." />

                <TextBlock Text="yt-dlp.exe path" Margin="0,4,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding YtDlpPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PlaceholderText="(leave blank to auto-detect via PATH)" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="OnBrowseYtDlp" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Test" Click="OnTestYtDlp" />
                </Grid>

                <!-- Manage row: SIDM-managed yt-dlp install in %LocalAppData%\SIDM\bin\.
                     Install pulls from yt-dlp's GitHub Releases; Uninstall removes
                     the managed copy; Refresh re-runs the resolver and updates the
                     status box. Existing Browse stays for users with a pinned path. -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                               Content="Install"
                               Click="OnInstallYtDlp"
                               ToolTip="Download the latest yt-dlp.exe from GitHub into %LocalAppData%\SIDM\bin\." />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}"
                               Margin="8,0,0,0"
                               Content="Uninstall"
                               Click="OnUninstallYtDlp"
                               ToolTip="Remove the SIDM-managed yt-dlp.exe (leaves any user-pinned path alone)." />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                               Margin="8,0,0,0"
                               Content="Refresh"
                               Click="OnRefreshYtDlp"
                               ToolTip="Re-scan the resolver chain and update the status below." />
                </StackPanel>

                <TextBlock Text="ffmpeg.exe path" Margin="0,12,0,4" />
                <TextBlock Margin="0,0,0,4" Opacity="0.65" FontSize="11"
                           Text="Required to merge video + audio for resolutions ≥ 1080p (without it, yt-dlp saves separate files)." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                PlaceholderText="(leave blank to auto-detect via PATH)" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="OnBrowseFfmpeg" />
                </Grid>

                <!-- Mirror of the yt-dlp manage row. Install pulls ffmpeg.exe
                     from the yt-dlp/FFmpeg-Builds GitHub release zip and
                     extracts just bin/ffmpeg.exe into %LocalAppData%\SIDM\bin\. -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                               Content="Install"
                               Click="OnInstallFfmpeg"
                               ToolTip="Download a static ffmpeg.exe from the yt-dlp/FFmpeg-Builds GitHub release into %LocalAppData%\SIDM\bin\." />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}"
                               Margin="8,0,0,0"
                               Content="Uninstall"
                               Click="OnUninstallFfmpeg"
                               ToolTip="Remove the SIDM-managed ffmpeg.exe (leaves any user-pinned path alone)." />
                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                               Margin="8,0,0,0"
                               Content="Refresh"
                               Click="OnRefreshFfmpeg"
                               ToolTip="Re-scan the resolver chain and update the status below." />
                </StackPanel>

                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock Text="{Binding YtDlpStatus}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,24,0,0" Text="Browser extensions" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="Which browsers are detected and whether the SIDM extension has connected. Use Manage to install or re-install for a specific browser." />

                <Border Background="#15FFFFFF" CornerRadius="6" Padding="8">
                    <ItemsControl ItemsSource="{Binding BrowserExtensions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.75" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Manage extensions…" Click="OnManageBrowserExtensions" />
                </StackPanel>

                <TextBlock Margin="0,24,0,0" Text="Updates" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11"
                           Text="SIDM uses Velopack to install over itself. Point this at the folder or URL where your release nupkgs live." />

                <TextBlock Text="Update feed URL" Margin="0,4,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding UpdateFeedUrl, Mode=OneWay}"
                                IsReadOnly="True"
                                ToolTip="{Binding UpdateFeedUrl}"
                                PlaceholderText="https://github.com/owner/SIDM or https://releases.snw.dev/sidm/" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Check now" Click="OnCheckUpdates" />
                </Grid>

                <CheckBox Margin="0,12,0,0" Content="Check for updates at startup"
                          IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}" />

                <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                        Visibility="{Binding UpdateStatus, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
                        <ui:Button Margin="0,8,0,0" Content="Install update and restart" Appearance="Primary"
                                   Click="OnApplyUpdate"
                                   Visibility="{Binding UpdateReadyToApply, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,24,0,0" Text="Privacy" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,8" Opacity="0.65" FontSize="11" TextWrapping="Wrap"
                           Text="Off by default. When on, anonymized crash reports are sent to Sentry to help us fix bugs faster. URLs, filenames, and cookie strings are redacted before anything leaves your machine." />
                <CheckBox Content="Send anonymized crash reports" IsChecked="{Binding CrashReportsEnabled, Mode=TwoWay}" />

                <TextBlock Text="Sentry DSN (optional override)" Margin="0,12,0,4" />
                <ui:TextBox Text="{Binding CrashReportsDsn, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            PlaceholderText="https://...ingest.sentry.io/..." />
                <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.65"
                           Text="Leave blank to use the SIDM project DSN once the public org is live." />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
            </StackPanel>
        </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                <ui:Button Content="Save" Appearance="Primary" Click="OnAccept" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
