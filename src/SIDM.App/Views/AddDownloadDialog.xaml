<ui:FluentWindow x:Class="SIDM.App.Views.AddDownloadDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SIDM.App.ViewModels"
                 mc:Ignorable="d"
                 Title="Add download"
                 Height="480"
                 Width="660"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/Resources/sidm.png"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 d:DataContext="{d:DesignInstance Type=vm:AddDownloadViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add download" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="URL" Margin="0,0,0,4" />
            <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="https://example.com/installer.exe" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Size: " Opacity="0.7" />
                    <TextBlock Text="{Binding SizeDisplay}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Type: " Opacity="0.7" />
                    <TextBlock Text="{Binding MimeDisplay}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <TextBlock Text="File name" Margin="0,16,0,4" />
            <ui:TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Save to folder" Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="OnBrowse" />
            </Grid>
            <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.65"
                       Text="The folder is remembered for files with this extension." />

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding IsVideoUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#22FF8C00" CornerRadius="6" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Video24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                            <Run Text="Video URL detected — will download via yt-dlp." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding IsHlsUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#2200B8D4" CornerRadius="6" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Stream24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                            <Run Text="HLS playlist detected — segments will be fetched in parallel and concatenated to .ts." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding IsDashUrl, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#22008B6E" CornerRadius="6" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Stream24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                            <Run Text="DASH manifest detected — video + audio tracks will be fetched and muxed to .mp4 (ffmpeg required for muxing)." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Format row — populated when the user picked a resolution /
                 audio bitrate via the browser-overlay format picker. yt-dlp
                 will be invoked with this exact selector. Hidden otherwise. -->
            <StackPanel Margin="0,16,0,0"
                        Visibility="{Binding HasYtDlpFormat, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#22F0A020" CornerRadius="6" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Cloud24" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Format chosen from the in-browser picker:"
                                       FontSize="11" Opacity="0.75" />
                            <TextBlock Text="{Binding YtDlpFormatLabel}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding IsSpecialUrl, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <TextBlock Text="Segments (parallel connections)" Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Segments, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Segments}" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}" />
        </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                <ui:Button Content="Start download" Appearance="Primary" Click="OnAccept" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
