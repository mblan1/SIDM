<ui:FluentWindow x:Class="SIDM.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SIDM.App.ViewModels"
                 mc:Ignorable="d"
                 Title="SIDM"
                 Icon="pack://application:,,,/Resources/sidm.png"
                 Height="640"
                 Width="1200"
                 MinWidth="900"
                 MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <!-- Browser extension install banner — shown until at least one
             browser extension has handshaked with SIDM. -->
        <Border Grid.Row="1"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                Padding="16,10"
                Visibility="{Binding ShowBrowserExtensionBanner, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="PuzzlePiece24"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           Text="Install the SIDM browser extension to capture downloads automatically." />
                <ui:Button Grid.Column="2"
                           Content="Install"
                           Click="OnOpenBrowserExtensionDialog"
                           Margin="0,0,8,0" />
                <ui:Button Grid.Column="3"
                           Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                           Appearance="Transparent"
                           ToolTip="Dismiss"
                           Command="{Binding DismissBannerCommand}" />
            </Grid>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,8,16,8">
            <ui:Button Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Add24}"
                       Content="Add download"
                       Command="{Binding Downloads.AddCommand}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Pause24}"
                       Content="Pause"
                       Command="{Binding Downloads.PauseSelectedCommand}"
                       CommandParameter="{Binding Downloads.SelectedRow}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Play24}"
                       Content="Resume"
                       Command="{Binding Downloads.ResumeSelectedCommand}"
                       CommandParameter="{Binding Downloads.SelectedRow}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Delete24}"
                       Content="Remove"
                       Command="{Binding Downloads.RemoveSelectedCommand}"
                       CommandParameter="{Binding Downloads.SelectedRow}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Settings24}"
                       Content="Settings"
                       Command="{Binding Downloads.OpenSettingsCommand}" />
        </StackPanel>

        <!-- Sidebar + grid -->
        <!-- Background="Transparent" makes the gap between sidebar and grid
             hit-testable so MouseDown fires there. The handler stays OFF the
             root Grid because that would extend into the title bar region
             and clash with WindowChrome's caption hit-testing (drag-to-move
             stops working). -->
        <Grid Grid.Row="3" Margin="16,8,16,8"
              Background="Transparent"
              MouseDown="OnContentMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="160" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categories sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                    CornerRadius="8" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Categories"
                               Margin="12,8,8,4"
                               FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Categories.Nodes}"
                             SelectedItem="{Binding Categories.SelectedNode, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="Margin" Value="2,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"
                                             Fill="{Binding Color, FallbackValue=#888888, TargetNullValue=#888888}" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Download list -->
            <DataGrid x:Name="DownloadsGrid"
                      Grid.Column="2"
                      ItemsSource="{Binding Categories.RowsView}"
                      SelectedItem="{Binding Downloads.SelectedRow, Mode=TwoWay}"
                      SelectionChanged="OnDownloadsGridSelectionChanged"
                      PreviewMouseDown="OnDownloadsGridPreviewMouseDown"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}"
                      BorderThickness="0"
                      RowHeight="40"
                      ColumnHeaderHeight="32"
                      VerticalGridLinesBrush="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <DataGrid.Resources>
                    <!-- DataGridTextColumn renders its values as auto-generated
                         TextBlocks that ignore the cell's VerticalContentAlignment.
                         Force every cell-level TextBlock to center vertically so
                         the Size/Status/Time left/etc rows line up with the
                         icon+text File Name column (which already aligns center). -->
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>

                    <!-- Right-click actions on a download row. The ContextMenu
                         lives in resources (rather than inline in the Style
                         Setter) because WPF won't accept Click handlers on
                         MenuItems nested in a Setter.Value. x:Shared=False
                         hands each row a fresh ContextMenu instance so its
                         DataContext (the row VM) doesn't get crossed wires. -->
                    <ContextMenu x:Key="DownloadRowContextMenu" x:Shared="False">
                        <MenuItem Header="Open file" Click="OnContextOpenFile">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Open24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open file location" Click="OnContextOpenFolder">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Pause" Click="OnContextPause">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Pause24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Resume" Click="OnContextResume">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Copy URL" Click="OnContextCopyUrl">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Properties" Click="OnContextProperties">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Info24" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Remove…" Click="OnContextRemove">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                        <Setter Property="ContextMenu" Value="{StaticResource DownloadRowContextMenu}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <!-- Shell icon + file name -->
                    <DataGridTemplateColumn Header="File Name" Width="2.5*" MinWidth="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <!-- Fallback monochrome glyph; hidden when the shell icon resolves. -->
                                        <ui:SymbolIcon Symbol="{Binding FileIcon}"
                                                       FontSize="18"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.6" />
                                        <Image Source="{Binding FileIconImage}"
                                               Width="20" Height="20"
                                               Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FileName}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="Auto" MinWidth="140" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="Auto" MinWidth="90" />
                    <DataGridTextColumn Header="Time left" Binding="{Binding TimeLeftDisplay}" Width="Auto" MinWidth="80" />
                    <DataGridTextColumn Header="Transfer rate" Binding="{Binding TransferRateDisplay}" Width="Auto" MinWidth="100" />
                    <DataGridTextColumn Header="Last Try" Binding="{Binding LastTryDisplay}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="Description" Binding="{Binding DescriptionDisplay}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Padding="16,6">
            <TextBlock Text="{Binding Downloads.StatusBarText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12" />
        </Border>
    </Grid>
</ui:FluentWindow>
