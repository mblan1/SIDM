<ui:FluentWindow x:Class="SIDM.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SIDM.App.ViewModels"
                 mc:Ignorable="d"
                 Title="SIDM"
                 Height="640"
                 Width="1100"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8,16,8">
            <ui:Button Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Add24}"
                       Content="Add download"
                       Command="{Binding Downloads.AddCommand}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Pause24}"
                       Content="Pause"
                       Command="{Binding Downloads.PauseCommand}"
                       CommandParameter="{Binding Downloads.SelectedRow}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Play24}"
                       Content="Resume"
                       Command="{Binding Downloads.ResumeCommand}"
                       CommandParameter="{Binding Downloads.SelectedRow}" />
            <ui:Button Margin="8,0,0,0"
                       Icon="{ui:SymbolIcon Symbol=Delete24}"
                       Content="Remove"
                       Command="{Binding Downloads.RemoveCommand}"
                       CommandParameter="{Binding Downloads.SelectedRow}" />
        </StackPanel>

        <!-- Download list -->
        <DataGrid Grid.Row="2" Margin="16,0,16,8"
                  ItemsSource="{Binding Downloads.Rows}"
                  SelectedItem="{Binding Downloads.SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#11FFFFFF"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="Auto" MinWidth="100" />
                <DataGridTemplateColumn Header="Progress" Width="3*" MinWidth="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" />
                                <TextBlock Text="{Binding ProgressDisplay}" Margin="4,8,0,0" FontSize="11" Opacity="0.85" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#22000000" Padding="16,6">
            <TextBlock Text="{Binding Downloads.StatusBarText}" FontSize="12" Opacity="0.8" />
        </Border>
    </Grid>
</ui:FluentWindow>
